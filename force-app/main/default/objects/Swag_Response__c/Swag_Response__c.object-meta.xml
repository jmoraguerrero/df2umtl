<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Swag Response</label>
    <pluralLabel>Swag Responses</pluralLabel>
    <description>A contact's swag quiz attempt. One record per contact holds their answers (JSON), total score, and awarded swag.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <enableSearch>true</enableSearch>
    <enableReports>true</enableReports>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <nameField>
        <label>Response Number</label>
        <type>AutoNumber</type>
        <displayFormat>SR-{00000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
</CustomObject>
